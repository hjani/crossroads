{
  "name": "crossroads",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "format": "prettier --write src scripts",
    "test": "vitest run",
    "docs:images": "rolldown scripts/docs-images/main.ts --file node_modules/.cache/docs-images.mjs --format esm --platform node && node node_modules/.cache/docs-images.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/three": "^0.185.4",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
