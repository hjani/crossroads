{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // Vite's ambient declarations, which say that importing a `.css` file
    // is a legal module import — TypeScript otherwise knows only code.
    "types": ["vite/client"]
  },
  "include": ["src"]
}
